# Copy to .env and fill in. Never put real secrets in this file — it is a
# template meant to be shared/committed.

# LinkedIn Credentials (use a burner account!)
LINKEDIN_EMAIL=your-email@example.com
LINKEDIN_PASSWORD=your-password

# Gmail SMTP Settings (needs a Google App Password, not your account password)
GMAIL_EMAIL=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Mistral AI — enables AI extraction and email drafting.
# Without it the app falls back to regex extraction and still works.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_FALLBACK_MODELS=mistral-medium-latest,open-mistral-nemo
MISTRAL_CONCURRENCY=1
# Requests/min ceiling the app throttles itself to.
MISTRAL_RPM=30
# Posts per extraction request; batching keeps request counts low.
MISTRAL_BATCH_SIZE=5

# Used to personalise AI-drafted emails
CANDIDATE_NAME=
CANDIDATE_SUMMARY=

# App Settings
DATABASE_URL=sqlite+aiosqlite:///./linkedin_mailer.db
SCROLL_PAGES_PER_QUERY=20
SCRAPE_DELAY_MIN=3
SCRAPE_DELAY_MAX=7

# Email safety limits
EMAIL_RATE_LIMIT=20        # messages per minute
EMAIL_DAILY_LIMIT=400      # per 24h; Gmail personal accounts cap near 500
EMAIL_COOLDOWN_DAYS=30     # don't re-email the same address within N days
MAX_RESUME_MB=10
